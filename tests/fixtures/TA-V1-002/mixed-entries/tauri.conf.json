{
  "build": { "distDir": "../dist", "devPath": "../dist" },
  "package": { "productName": "remote-mixed", "version": "0.1.0" },
  "tauri": {
    "allowlist": { "all": false },
    "security": {
      "csp": "default-src 'self'",
      "dangerousRemoteDomainIpcAccess": [
        { "domain": "docs.example.com", "windows": ["help"] },
        { "domain": "app.example.com", "windows": ["main"], "enableTauriAPI": true }
      ]
    }
  }
}
